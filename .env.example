# Required browser configuration. Use the publishable/anon key, never service_role.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional browser features
VITE_GIPHY_API_KEY=

# Server/CLI only. Never give these a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
SERPER_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Cloudflare TURN: backend secrets, NEVER prefix these names with VITE_.
# After filling .env, run npm run setup:turn to publish only these secrets to Supabase.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_TTL=3600
# Set FCM_SERVICE_ACCOUNT as a Supabase Edge Function secret, not browser config.

# Optional server-only OSM services, set as Supabase Edge Function secrets.
# Leave blank to use public community services.
PHOTON_BASE_URL=
OVERPASS_URL=
