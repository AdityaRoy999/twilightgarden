{
  "name": "twilight-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3100 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3100",
    "test": "vitest run",
    "infra:check": "tsc --noEmit -p infra/tsconfig.json",
    "infra:synth": "cdk synth --quiet",
    "infra:diff": "cdk diff",
    "infra:deploy": "cdk deploy --outputs-file deployment.local.json",
    "site:publish": "node scripts/publish.mjs",
    "admin:invite": "node scripts/invite.mjs",
    "check": "npm run build && npm run infra:check && npm test",
    "audit:security": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "framer-motion": "^12.34.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "aws-cdk": "^2.1000.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.4.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.0"
  }
}
